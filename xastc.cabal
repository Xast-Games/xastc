cabal-version:      3.0
name:               xastc
version:            0.1.0.0
description:        Xast language compiler
license:            Unlicense
license-file:       LICENSE
author:             Oleksandr Hnutov
maintainer:         sanerhp.mail@gmail.com
build-type:         Simple

common warnings
    ghc-options: -Wall
    default-extensions:
        OverloadedRecordDot
        NoFieldSelectors
        DuplicateRecordFields

library
    import:           warnings
    exposed-modules:  
        Xast.AST,
        Xast.Config,
        Xast.Pipeline,
        Xast.Html,

        Xast.Error.Pretty,
        Xast.Error.Types,

        Xast.Parser.Modifier,
        Xast.Parser.Common,
        Xast.Parser.Expr,
        Xast.Parser.Extern,
        Xast.Parser.Function,
        Xast.Parser.Headers,
        Xast.Parser.Ident,
        Xast.Parser.Program,
        Xast.Parser.System,
        Xast.Parser.Type,

        Xast.SemAnalyzer.Pass,
        Xast.SemAnalyzer.Declare,
        Xast.SemAnalyzer.Imports,
        Xast.SemAnalyzer.TypeUsages,
        Xast.SemAnalyzer.ResolveNames,
        Xast.SemAnalyzer.IntBounds,
        Xast.SemAnalyzer.Unify,
        Xast.SemAnalyzer.Exhaustive,
        Xast.SemAnalyzer.TypeUtils,
        Xast.SemAnalyzer.InferPattern,
        Xast.SemAnalyzer.InferExpr,
        Xast.SemAnalyzer.TypeCheck,
        Xast.SemAnalyzer.Desugar,
        Xast.SemAnalyzer.Monad,
        Xast.SemAnalyzer.Query,
        Xast.SemAnalyzer.Types,

        Xast.Lowerer.Monad,
        Xast.Lowerer.Types,
        Xast.Lowerer.Pass,
        Xast.Lowerer.Definition,
        Xast.Lowerer.Match,
        Xast.Lowerer.Expr,
        Xast.Lowerer.DecisionTree,
        Xast.Lowerer.Mono,

        Xast.Codegen.C.Monad,
        Xast.Codegen.C.Types,
        Xast.Codegen.C.Pass,
        Xast.Codegen.C.Pretty,

        Xast.Utils.Compiler,
        Xast.Utils.List,
        Xast.Utils.Pretty,
        Xast.Utils.Generic,

    build-depends:   
        process ^>=1.6.19.0, 
        tomland, 
        mtl ^>=2.3.1,
        base ^>=4.18.3.0,
        megaparsec ==9.7.0,
        text ==2.0.2,
        containers ==0.6.7,
        vector ==0.13.2.0,
        directory ==1.3.9.0,
        parser-combinators ==1.3.0,
        diagnose,
        prettyprinter ==1.7.2
    hs-source-dirs:   src
    default-language: GHC2021

executable xastc
    import:           warnings
    main-is:          Main.hs
    build-depends:
        base ^>=4.18.3.0,
        text ==2.0.2,
        xastc

    hs-source-dirs:   app
    default-language: GHC2021

test-suite xastc-test
    import:           warnings
    default-language: GHC2021
    type:             exitcode-stdio-1.0
    hs-source-dirs:   test
    main-is:          Main.hs
    other-modules:
        Parser,
        SemAnalyzer
    build-depends:
        base ^>=4.18.3.0,
        mtl ^>=2.3.1,
        megaparsec ==9.7.0,
        text ==2.0.2,
        HUnit ==1.6.2.0,
        containers ==0.6.7,
        xastc
