module Std.Result exports *

use Std.Bool *
use Std.Error { error }

@Copyable 
type Result a e = Ok a | Err e;

fn isOk (Result a e) -> Bool;
fn isOk result = match result with
    Ok _ -> True,
    _    -> False;

fn isErr (Result a e) -> Bool;
fn isErr result = match result with
    Ok _ -> False,
    _    -> True;

fn unwrap (Result a e) -> a;
fn unwrap result = match result with 
    Ok a -> a,
    _    -> error "trying to unwrap on `Err`";

fn unwrapErr (Result a e) -> e;
fn unwrapErr result = match result with 
    Err e -> e,
    _     -> error "trying to unwrap error on `Ok`";

fn unwrapOr (Result a e, a) -> a;
fn unwrapOr result b = match result with 
    Ok a -> a,
    _    -> b;

fn map (fn(a) -> b, Result a e) -> Result b e;
fn map f result = match result with
    Ok a  -> Ok (f a),
    Err e -> Err e;

fn andThen (fn(a) -> Result b e, Result a e) -> Result b e;
fn andThen f result = match result with
    Ok a  -> f a,
    Err e -> Err e;

fn flatten (Result (Result a e) e) -> Result a e;
fn flatten result = match result with
    Ok (Ok a)  -> Ok a,
    Ok (Err e) -> Err e,
    Err e      -> Err e;