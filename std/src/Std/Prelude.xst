module Std.Prelude exports {
    -- Bool:
    Bool(..),

    -- Char:
    Char,

    -- Error:
    error,

    -- Function:
    id, const,

    -- Num:
    Size,   USize,
    Long,   ULong,
    Int,    UInt,
    Short,  UShort,
    Byte,   UByte,
    Float,  Double,

    -- Ops:
    -- # arithmetical:
    opAdd, opSub, opMul, opDiv, opMod, opPow, opNeg,
    -- # comparison:
    opEq, opNeq, opLt, opGt, opLe, opGe,
    -- # logical:
    opAnd, opOr, opNot,
    -- # arrays:
    opConcat,
    -- # bitwise:
    opBitwiseAnd, opBitwiseOr, opBitwiseXor, 
    opShiftLeft, opShiftRight,

    -- Option:
    Option(..),

    -- Result:
    Result(..),

    -- String:
    String,

    -- Trace:
    debugTrace,
}

use Std.Bool { Bool, True, False }
use Std.Error { error }
use Std.Num {
    Size,   USize,
    Long,   ULong,
    Int,    UInt,
    Short,  UShort,
    Byte,   UByte,
    Float,  Double,
}
use Std.String { String }
use Std.Char { Char }
use Std.Function { id, const }
use Std.Ops {
    opAdd, opSub, opMul, opDiv, opMod, opPow, opNeg,
    opEq, opNeq, opLt, opGt, opLe, opGe,
    opAnd, opOr, opNot,
    opConcat,
    opBitwiseAnd, opBitwiseOr, opBitwiseXor, 
    opShiftLeft, opShiftRight,
}
use Std.Option { Option, Some, None }
use Std.Result { Result, Ok, Err }
use Std.Trace { debugTrace }